POSTGRES_USER=interviewarena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interviewarena

DATABASE_URL=postgresql+psycopg://interviewarena:change-me@postgres:5432/interviewarena
TEST_DATABASE_URL=postgresql+psycopg://interviewarena:change-me@postgres:5432/interviewarena_test

# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ENVIRONMENT=development
# JSON list or comma-separated, e.g. https://interviewarena.vercel.app
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# used only by `python -m scripts.seed` to create/promote the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Running coding questions:
#   local     Python only, a resource-limited subprocess. For your own machine/docker compose. It REFUSES to run
#             when ENVIRONMENT=production because it is not a security boundary.
#   judge0    sandboxed execution on a Judge0 service (use this for any public deployment). Needs JUDGE0_URL.
#   disabled  coding questions can be read but not run
CODE_RUNNER=local
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com  JUDGE0_API_HOST=judge0-ce.p.rapidapi.com  JUDGE0_API_KEY=<your key>
# Self-hosted Judge0: JUDGE0_URL=https://your-judge0-host  (JUDGE0_API_KEY only if you set AUTHN_TOKEN)

# Generative AI (hints, AI feedback on short answers, admin question generator). Everything else works without it.
#   LLM_PROVIDER=disabled | openai_compatible | anthropic
# openai_compatible works with OpenAI, Groq, Gemini's OpenAI-compatible endpoint, OpenRouter, Ollama...
#   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<model id from your provider>   LLM_API_KEY=<key>
# anthropic: LLM_MODEL=<model id>  LLM_API_KEY=<key>   (LLM_BASE_URL optional)
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
AI_DAILY_LIMIT_PER_USER=30
ML_ENABLED=true
RATE_LIMIT_ENABLED=true
